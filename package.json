{
  "name": "joindex-craftform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,api -c blue,green \"vite\" \"npm run mock\"",
    "dev:vite": "vite",
    "mock": "json-server --watch mocks/db.json --host 127.0.0.1 --port 3001",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "typecheck": "tsc -b --noEmit"
  },
